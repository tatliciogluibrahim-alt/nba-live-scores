# No Noise Scores — environment variables.
#
# Copy this file to .env.local and fill the values to enable Web Push.
# Generate a fresh VAPID keypair with:
#   node scripts/generate-vapid-keys.mjs

# VAPID — required for Web Push. The PUBLIC key is also exposed to the
# client as NEXT_PUBLIC_VAPID_PUBLIC_KEY. They must match.
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# VAPID subject — a contact URL for push service operators. Must be a
# mailto: or https: URL. Push services (Apple, FCM, Mozilla) use this
# to reach a human if your pushes start misbehaving at scale.
VAPID_SUBJECT=mailto:you@nonoisescores.app

# Vercel KV / Upstash Redis — required for durable push subscriptions and
# push endpoint rate limiting. Vercel provisions these when you add a Redis
# integration to the project.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Cron secret — protects /api/cron/scan-nba so only the trusted external
# cron (currently GitHub Actions; see .github/workflows/scan-nba-cron.yml)
# can trigger pushes. Set the same value in Vercel project env AND as a
# GitHub repo secret named CRON_SECRET. The workflow sends it as
# `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=
